# ─────────────────────────────────────────────────────────────────────────────
#  Fastfile — Alma App automation
#
#  Usage:
#    bundle exec fastlane ios ci_beta       → CI: build + TestFlight
#    bundle exec fastlane ios beta          → build + TestFlight
#    bundle exec fastlane ios release       → build + App Store
#    bundle exec fastlane android beta      → build + Play Internal
#    bundle exec fastlane android release   → build + Play Production
# ─────────────────────────────────────────────────────────────────────────────

default_platform(:ios)

# ══ iOS ═══════════════════════════════════════════════════════════════════════

platform :ios do

  desc "CI: Build and upload to TestFlight"
  lane :ci_beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILE"],
      duration:     1200,
      in_house:     false
    )

    # Revoke ALL existing Distribution certificates to free up quota.
    begin
      %w[DISTRIBUTION IOS_DISTRIBUTION].each do |cert_type|
        certs = Spaceship::ConnectAPI::Certificate.all(
          filter: { certificateType: cert_type }
        )
        certs.each do |c|
          UI.message("Revoking orphaned #{cert_type} cert: #{c.display_name} (#{c.id})")
          Spaceship::ConnectAPI.delete_certificate(certificate_id: c.id)
        end
      end
    rescue => e
      UI.important("Could not revoke existing certs (non-fatal): #{e.message}")
    end

    create_keychain(
      name:               "signing",
      password:           "gh-actions-signing",
      default_keychain:   false,
      unlock:             true,
      timeout:            3600,
      add_to_search_list: true
    )

    cert(
      api_key:              api_key,
      keychain_path:        File.expand_path("~/Library/Keychains/signing-db"),
      keychain_password:    "gh-actions-signing",
      generate_apple_certs: true
    )

    sigh(
      api_key:        api_key,
      app_identifier: "com.almaapp.app",
      force:          true
    )

    # Write manual signing into xcodeproj (app targets only, not SPM packages).
    # Passing PROVISIONING_PROFILE_SPECIFIER via xcargs applies globally and
    # conflicts with SPM package targets that use automatic signing.
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "Alma.App.Oficial.xcodeproj",
      team_id:               ENV["APPLE_TEAM_ID"],
      code_sign_identity:    "Apple Distribution",
      profile_uuid:          lane_context[SharedValues::SIGH_UUID]
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj:    "Alma.App.Oficial.xcodeproj"
    )

    build_ios_app(
      project:           "Alma.App.Oficial.xcodeproj",
      scheme:            "Alma.App.Oficial (iOS)",
      configuration:     "Release",
      export_method:     "app-store",
      output_directory:  "./build",
      output_name:       "Alma.ipa"
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Run tests"
  lane :test do
    run_tests(
      project:     "Alma.App.Oficial.xcodeproj",
      scheme:      "Alma.App.Oficial (iOS)",
      destination: "platform=iOS Simulator,name=iPhone 15"
    )
  end

  desc "Build and upload to TestFlight (beta)"
  lane :beta do
    increment_build_number(xcodeproj: "Alma.App.Oficial.xcodeproj")
    build_ios_app(
      project:           "Alma.App.Oficial.xcodeproj",
      scheme:            "Alma.App.Oficial (iOS)",
      configuration:     "Release",
      export_method:     "app-store",
      output_directory:  "./build",
      output_name:       "Alma.ipa"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      apple_id:                          ENV["APPLE_ID"]
    )
  end

  desc "Build and upload to App Store (metadata + binary, sem submit)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILE"],
      duration:     1200,
      in_house:     false
    )

    increment_build_number(xcodeproj: "Alma.App.Oficial.xcodeproj")

    build_ios_app(
      project:           "Alma.App.Oficial.xcodeproj",
      scheme:            "Alma.App.Oficial (iOS)",
      configuration:     "Release",
      export_method:     "app-store",
      output_directory:  "./build",
      output_name:       "Alma.ipa"
    )

    upload_to_app_store(
      api_key:               api_key,
      skip_metadata:         false,
      skip_screenshots:      true,
      submit_for_review:     false,
      automatic_release:     false,
      precheck_include_in_app_purchases: false,
      force:                 true,
      metadata_path:         "./fastlane/metadata/ios"
    )
  end

  desc "Sobe APENAS metadata para a ASC — sem build, sem screenshots, sem submit"
  lane :deliver_metadata_only do
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILE"],
      duration:     1200,
      in_house:     false
    )

    upload_to_app_store(
      api_key:                           api_key,
      skip_binary_upload:                true,
      skip_screenshots:                  true,
      submit_for_review:                 false,
      automatic_release:                 false,
      precheck_include_in_app_purchases: false,
      force:                             true,
      metadata_path:                     "./fastlane/metadata/ios"
    )
  end

  desc "Atualiza Sign-In Information (App Review) via Spaceship — NÃO toca outros metadata"
  lane :submit_review_info do
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILE"],
      duration:     1200,
      in_house:     false
    )

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key:       api_key[:key]
    )

    bundle_id = ENV["APP_IDENTIFIER"] || "com.almaapp.app"
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("App #{bundle_id} not found") unless app

    candidates = [
      File.expand_path("./metadata/ios/review_information"),
      File.expand_path("./fastlane/metadata/ios/review_information")
    ]
    ri_path = candidates.find { |p| Dir.exist?(p) } || candidates.first
    UI.message("Lendo de: #{ri_path}")

    read_field = lambda do |name|
      path = File.join(ri_path, "#{name}.txt")
      next nil unless File.exist?(path)
      content = File.read(path).strip
      content.empty? ? nil : content
    end

    first_name    = read_field.call("first_name")
    last_name     = read_field.call("last_name")
    email_address = read_field.call("email_address")
    phone         = read_field.call("phone_number")
    demo_user     = read_field.call("demo_user")
    demo_password = read_field.call("demo_password")
    notes         = read_field.call("notes")

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable iOS version found — create a draft version on ASC first") unless version

    UI.message("Editable version: #{version.version_string} (state: #{version.app_store_state})")

    review_detail = version.fetch_app_store_review_detail
    UI.user_error!("Could not fetch app_store_review_detail") unless review_detail

    attrs = {}
    attrs[:contact_first_name]    = first_name    if first_name
    attrs[:contact_last_name]     = last_name     if last_name
    attrs[:contact_email]         = email_address if email_address
    attrs[:contact_phone]         = phone         if phone
    attrs[:demo_account_name]     = demo_user     if demo_user
    attrs[:demo_account_password] = demo_password if demo_password
    attrs[:demo_account_required] = true          if demo_user && demo_password
    attrs[:notes]                 = notes         if notes

    UI.message("Enviando #{attrs.keys.size} campos: #{attrs.keys.map(&:to_s).join(', ')}")
    review_detail.update(attributes: attrs)

    # Re-fetch pra confirmar
    fresh = version.fetch_app_store_review_detail
    UI.success("✅ Sign-In Information atualizada na ASC para versão #{version.version_string}")
    UI.message("Estado pós-update no servidor:")
    UI.message("  contact_first_name:   #{fresh.contact_first_name}")
    UI.message("  contact_last_name:    #{fresh.contact_last_name}")
    UI.message("  contact_email:        #{fresh.contact_email}")
    UI.message("  contact_phone:        #{fresh.contact_phone || '(não setado)'}")
    UI.message("  demo_account_name:    #{fresh.demo_account_name}")
    UI.message("  demo_account_password: <#{fresh.demo_account_password ? 'set' : 'unset'}>")
    UI.message("  demo_account_required: #{fresh.demo_account_required}")
    UI.message("  notes (chars):        #{fresh.notes&.length || 0}")
  end

  desc "Dry-run: valida API key + metadata local, sem tocar a ASC"
  lane :verify_metadata do
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILE"],
      duration:     1200,
      in_house:     false
    )

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:     api_key[:key_id],
      issuer_id:  api_key[:issuer_id],
      key:        api_key[:key]
    )

    bundle_id = ENV["APP_IDENTIFIER"] || "com.almaapp.app"
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app
      UI.success("API key OK — app encontrado: #{app.name} (#{app.bundle_id})")
    else
      UI.user_error!("App #{bundle_id} não encontrado com esta API key")
    end

    precheck(
      api_key:                  api_key,
      app_identifier:           bundle_id,
      default_rule_level:       :warn,
      include_in_app_purchases: false
    )
  end

end

# ══ Android ═══════════════════════════════════════════════════════════════════

platform :android do

  desc "Build and upload to Google Play Internal track"
  lane :beta do
    gradle(
      task:        "bundle",
      build_type:  "Release",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file"     => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_STORE_PASSWORD"],
        "android.injected.signing.key.alias"      => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password"   => ENV["ANDROID_KEY_PASSWORD"],
      }
    )
    upload_to_play_store(
      track:        "internal",
      aab:          "android/app/build/outputs/bundle/release/app-release.aab",
      package_name: "AlmaOficial.Alma"
    )
  end

  desc "Promote Internal → Production on Google Play"
  lane :release do
    upload_to_play_store(
      track:            "internal",
      track_promote_to: "production",
      package_name:     "AlmaOficial.Alma"
    )
  end

end
