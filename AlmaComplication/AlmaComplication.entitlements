<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A complicação lê o estado do dia (streak, água, treino) do App Group
	     que o app do relógio mantém. Sem isto, o widget não vê nada. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.almaapp.shared</string>
	</array>
</dict>
</plist>
